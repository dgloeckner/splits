# /etc/splits/splits.env — production config consumed by splits.service.
# Replace placeholders via deploy/install.sh; mode 0640 root:splits.

# Bind only on loopback; Caddy reverse-proxies from 443.
SPLITS_ADDR=127.0.0.1:8080

# SQLite DB path. /var/lib/splits is the systemd ReadWritePath.
SPLITS_DB_PATH=/var/lib/splits/splits.db

# Public URL the PWA was installed from. Used by the pairing endpoint
# to construct pairing URLs and by the CORS guard.
SPLITS_PUBLIC_URL=https://{{HOSTNAME}}

# Tells the T10 startup gate that TLS is terminated upstream by Caddy
# (otherwise the backend refuses to start non-localhost).
SPLITS_TLS_TERMINATED_BY=proxy

# Sessionizer idle timeout (default 60s). Tune if needed.
SPLITS_IDLE_TIMEOUT=60s

# Serial port (auto-detect when empty; the IPM is at /dev/ttyUSB0 on
# Pi by default — set explicitly to skip discovery on first boot):
# SPLITS_SERIAL_PORT=/dev/ttyUSB0

# DEV-ONLY toggles — leave commented in production:
# SPLITS_DEV_MODE=1
# SPLITS_FIXTURE=/path/to/fixture.csv
# SPLITS_FIXTURE_RATE=fast
