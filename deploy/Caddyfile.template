# Production Caddy config for splits.
# Replace {{HOSTNAME}} and {{DUCKDNS_TOKEN}} via deploy/install.sh.
# Backend listens on 127.0.0.1:8080; Caddy is the only public-facing
# process. ADR-0006 picks DNS-01 via DuckDNS to avoid port 80/443
# inbound on the LAN.

{{HOSTNAME}} {
    tls {
        dns duckdns {{DUCKDNS_TOKEN}}
    }

    # SSE stream — explicit per-event flush, no compression. Caddy
    # auto-flushes on text/event-stream but flush_interval -1 makes
    # it explicit and prevents future regressions.
    @sse path /api/v1/stream*
    handle @sse {
        reverse_proxy 127.0.0.1:8080 {
            flush_interval -1
            transport http {
                read_timeout 0s
                read_buffer 4KB
                compression off
            }
        }
    }

    # Reverse-proxy the splits API.
    handle /api/* {
        reverse_proxy 127.0.0.1:8080 {
            transport http {
                read_timeout 0s
                read_buffer 4KB
            }
        }
    }

    # Health probe (uncached).
    handle /api/health {
        reverse_proxy 127.0.0.1:8080
    }

    # PWA shell + assets. Vite-built static under {{WEB_ROOT}}.
    handle {
        root * {{WEB_ROOT}}
        encode zstd gzip
        try_files {path} /index.html
        file_server
    }

    log {
        output file /var/log/caddy/splits.log {
            roll_size 10MiB
            roll_keep 5
        }
    }
}
