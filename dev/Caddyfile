homeergo.duckdns.org {
    tls {
        dns duckdns 32fbb33a-0200-4675-b9b1-d1a425019bdb
    }
    # API requests go to the Go backend
    handle /api/* {
        reverse_proxy localhost:8080
    }

    # Everything else: serve the PWA
    handle {
        root * /Users/dg/dev/ruderergo-stats/web/dist
        try_files {path} /index.html
        file_server
    }
}
